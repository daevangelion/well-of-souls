wait 20
expect map_enter 2000
click 592 32
expect panel_open 300
wait 5
key u
expect item_use 300
shot /tmp/wos-gap-itemuse-potion.bmp
key RIGHT
wait 3
key u
expect travel 600
shot /tmp/wos-gap-itemuse-travel.bmp
key g
expect panel_open 300
shot /tmp/wos-gap-itemuse-bag.bmp
quit
