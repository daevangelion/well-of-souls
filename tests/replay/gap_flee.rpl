key RETURN
wait 20
key RETURN
wait 20
expect map_enter 2000
hold RIGHT 60
expect hero_move 300
wait 20
keydown DOWN
expect encounter 2000
keyup DOWN
expect battle_start 600
# Round 1, before anything is animating on the hero: the window test fails, so this is a
# straight refusal -- no 30 % roll is spent, and the hero's record is now 0x2F.
key f
expect battle_flee_failed 300
# Round 1's monster commits. Nothing is pressed on that frame: the hero's record is
# already 0x2F from the refusal above, so the roll would be refused anyway.
expect battle_monster_act 9000
# ROUND_START re-arms every live combatant to 0x5F, so this is round 2's one live roll,
# taken on the frame the monster's 1000 ms attack animation starts.
expect battle_monster_act 9000
key f
expect battle_fled 900
expect map_enter 1200
quit
