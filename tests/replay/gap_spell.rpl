wait 20
expect map_enter 2000
# East out of the Gateway, south-west toward the castle, until the encounter roll fires.
click 19 40
expect battle_start 4000
key a
wait 60
expect battle_won 4000
expect map_enter 4000
# (151,275) is map 0 link 9 "Macgyver Castle", eleven units south of where the fight left him.
click 183 184
expect map_enter 3000
# Macgyver Castle, (158,322). castle1.ter is an 82x87 grid over a 328x350 jpg, so a cell is
# 4x4 pixels; the flood fill of that grid from the Main Gate to the Spell Training link 11 at
# (190,231) is two straight runs, east 32 then north 91.
hold RIGHT 130
hold UP 300
expect scene_enter 2000
shot /tmp/wos-gap-spellmaster.bmp
# Greetings, %2. / I feel my teachings will be more effective if first you meet with my
# brother, Master of The Hand. / Go now. Return to me after learning the ways of the HAND.
key RETURN
wait 40
key RETURN
wait 40
key RETURN
wait 40
key ESCAPE
wait 40
# music.ini [evergreen] midi1=scrn_overworld, logged on every map_enter.
expect music_play 600
quit
